{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "if [ \"$CI\" != \"true\" ]; then pnpm exec playwright install --with-deps; fi",
    "pretest": "tsc && next lint",
    "test": "vitest",
    "posttest": "pnpm format --log-level silent",
    "e2e": "playwright test -x --quiet",
    "format": "prettier . --write --cache --cache-strategy metadata --log-level warn",
    "format:check": "prettier . --check",
    "build": "next build -d",
    "prestart": "pnpm build",
    "start": "NODE_ENV=production next start",
    "start:ci": "CI=true pnpm build && pnpm dlx serve@latest out",
    "dev": "NODE_ENV=development next dev --turbopack"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "viem": "^2.31.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.53.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.3.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
