{
  "name": "foundry",
  "scripts": {
    "install": "forge install && forge update",
    "test": "forge test -vvv",
    "build": "forge build",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "require:anvil": "cast bn",
    "prebroadcast": "pnpm require:anvil",
    "broadcast": "forge script script/HelloWorld.local.s.sol --broadcast -f anvil",
    "broadcast:sepolia": "forge script script/HelloWorld.s.sol --broadcast -f sepolia --verify"
  }
}
