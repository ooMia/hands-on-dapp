{
  "name": "hands-on-dapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier . --write --cache --cache-strategy metadata --log-level warn && pnpm -r format",
    "format:check": "pnpm -r format:check",
    "setup:env": "docker compose up -d && pnpm --filter foundry broadcast",
    "ensure:env": "cast bn || pnpm run setup:env",
    "pretest": "pnpm run ensure:env",
    "test": "NODE_ENV=development pnpm -r test",
    "predev": "pnpm run ensure:env",
    "dev": "NODE_ENV=development pnpm run -r dev",
    "build": "NODE_ENV=production pnpm run -r build",
    "start": "NODE_ENV=production pnpm run --filter front start"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
